# Optional production providers. The checked-in catalog and place index work
# without them; never route autocomplete to public Nominatim.
# NOMINATIM_URL=https://your-authorised-geocoder.example/search
# OVERPASS_ENDPOINTS=https://your-authorised-overpass.example/api/interpreter
# OSM_USER_AGENT=KenyaGymFinder/1.0 (https://your-domain.example/contact)

# Optional licensed static-map fallback. Development can use Esri's public
# World Street Map; production does not, so set this before relying on it.
# ESRI_EXPORT_URL=https://your-map-provider.example/export

# Optional. Header your edge overwrites with the visitor IP. When set, rate
# limits read only this header (the right-most hop when it is x-forwarded-for).
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
