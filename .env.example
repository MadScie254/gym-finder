# Required in production. Use providers you are authorised to operate at scale.
# Public Nominatim and Overpass defaults are development-only.
NOMINATIM_URL=https://your-geocoder.example/search
OVERPASS_ENDPOINTS=https://your-overpass.example/api/interpreter,https://backup.example/api/interpreter
OSM_USER_AGENT=KenyaGymFinder/1.0 (https://your-domain.example/contact)

# Required in production. Development falls back to Esri's public World Street
# Map; production does not. Point these at a basemap you are licensed to proxy.
# ESRI_TILE_URL is the prefix before /{z}/{y}/{x}.
# ESRI_TILE_URL=https://your-tile-provider.example/tile
# ESRI_EXPORT_URL=https://your-map-provider.example/export

# Optional. Header your edge overwrites with the visitor IP. When set, rate
# limits read only this header (the right-most hop when it is x-forwarded-for).
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
