# Support contact for reports and claims (see docs/REVAMP_PLAN.md D4).
# VITE_ values ship in the public bundle: use a role address, never a personal one.
# VITE_SUPPORT_WHATSAPP=2547XXXXXXXX
# VITE_SUPPORT_EMAIL=support@example.org
# Canonical links, sitemap and robots.txt use SITE_URL, else Vercel's production domain, else localhost.
# Set it only when a custom domain exists, for example SITE_URL=https://example.org
# SITE_URL=
