{
  "name": "gym-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run contrast && npm run test && npm run build",
    "fetch-gyms": "node scripts/fetch-kenya-gyms.mjs",
    "curate-gyms": "node scripts/fetch-kenya-gyms.mjs --curate-existing",
    "fetch-places": "node scripts/fetch-kenya-places.mjs",
    "data:extract": "node scripts/data/extract-overture.mjs && node scripts/data/extract-osm.mjs",
    "data:build": "node scripts/data/build-gyms.mjs",
    "data:validate": "node scripts/data/validate.mjs",
    "contrast": "node scripts/contrast.mjs",
    "build:e2e": "vite build --mode e2e && node scripts/prerender.mjs",
    "e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "lucide-react": "1.72.0",
    "maplibre-gl": "^6.9.1",
    "minisearch": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "jsdom": "^27.4.0",
    "libphonenumber-js": "1.13.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^4.1.12",
    "zod": "4.6.6"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
